#!/data/data/com.termux/files/usr/bin/bash
# termux-http-proxy-blocklists — subscribe termux-http-proxy to domain blocklists.
#
#   termux-http-proxy-blocklists list                 subscriptions, size and age
#   termux-http-proxy-blocklists defaults             subscribe to the recommended lists
#   termux-http-proxy-blocklists add NAME URL         subscribe, and download it now
#   termux-http-proxy-blocklists remove NAME
#   termux-http-proxy-blocklists update [--if-older HOURS] [--quiet]
#                                                     download them again
#   termux-http-proxy-blocklists check DOMAIN         which lists block DOMAIN, and why
#
# Lists are domain lists, hosts files or AdBlock-style (||domain^) files; each entry
# also blocks its subdomains. Put "@@domain" in your own deny file
# (~/.config/termux-http-proxy/deny) to allow a domain whatever the lists say.
#
# The termux-http-proxy service passes every list here to the proxy with --deny-file.
# After an update the proxy rereads them (sv hup); after add or remove it restarts,
# since the set of files changes.
set -euo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
CONF_DIR="${TERMUX_PROXY_CONF:-$HOME/.config/termux-http-proxy}"
CONF="$CONF_DIR/blocklists.conf"
DIR="${TERMUX_PROXY_BLOCKLISTS:-$HOME/.local/share/termux-http-proxy/blocklists}"
SERVICE="${SVDIR:-$PREFIX/var/service}/termux-http-proxy"
MAX_BYTES=$((50 * 1024 * 1024))
MAX_LISTS=30 # The proxy takes 32 --deny-file options; leave room for the user's own
QUIET=0

HAGEZI=https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard
DEFAULTS="hagezi-pro-mini $HAGEZI/pro.mini-onlydomains.txt
hagezi-native-huawei $HAGEZI/native.huawei-onlydomains.txt"

say() { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
die() { printf 'termux-http-proxy-blocklists: %s\n' "$*" >&2; exit 1; }

mkdir -p "$CONF_DIR" "$DIR"
touch "$CONF"

valid_name() { [[ "$1" =~ ^[A-Za-z0-9._-]{1,64}$ ]]; }

subscriptions() { # name url, one per line
  grep -Ev '^[[:space:]]*(#|$)' "$CONF" || true
}

url_for() {
  subscriptions | awk -v n="$1" '$1 == n { print $2; exit }'
}

# Tells the proxy: reread (hup) after an update, restart when the set of files changed.
reload() {
  if [ -d "$SERVICE" ]; then
    sv "$1" "$SERVICE" >/dev/null 2>&1 && say "proxy: sv $1" || say "proxy: sv $1 failed (is termux-services running?)"
  else
    say "no termux-http-proxy service: restart the proxy with a --deny-file for each list in $DIR"
  fi
}

# Downloads one list, checks it looks like a blocklist, and moves it into place.
fetch() { # name url
  local name="$1" url="$2" tmp count
  tmp="$(mktemp "$DIR/.$name.XXXXXX")"
  if ! curl -fsSL --max-time 180 --max-filesize "$MAX_BYTES" -o "$tmp" "$url"; then
    rm -f "$tmp"
    printf '  %-24s download failed: %s\n' "$name" "$url" >&2
    return 1
  fi
  # Refuse what is clearly not a blocklist (an HTML error page, an empty file).
  count="$(grep -Evc '^[[:space:]]*([#!\[]|$)' "$tmp" || true)"
  if head -c 512 "$tmp" | grep -qi '<html\|<!doctype'; then
    rm -f "$tmp"
    printf '  %-24s not a blocklist (got HTML): %s\n' "$name" "$url" >&2
    return 1
  fi
  if [ "$count" -lt 10 ]; then
    rm -f "$tmp"
    printf '  %-24s only %s entries: not replacing it\n' "$name" "$count" >&2
    return 1
  fi
  chmod 600 "$tmp"
  mv -f "$tmp" "$DIR/$name.txt"
  say "$(printf '  %-24s %s entries' "$name" "$count")"
}

age_hours() { # file
  echo $(( ($(date +%s) - $(stat -c %Y "$1")) / 3600 ))
}

cmd_list() {
  local any=0 name url f
  while read -r name url; do
    any=1
    f="$DIR/$name.txt"
    if [ -f "$f" ]; then
      printf '%-24s %8s entries  %3sh old  %s\n' "$name" \
        "$(grep -Evc '^[[:space:]]*([#!\[]|$)' "$f" || true)" "$(age_hours "$f")" "$url"
    else
      printf '%-24s %8s          %s\n' "$name" "(none yet)" "$url"
    fi
  done < <(subscriptions)
  [ "$any" = 1 ] || echo "no blocklists: try 'termux-http-proxy-blocklists defaults'"
  local deny="$CONF_DIR/deny"
  [ -f "$deny" ] && printf '\nyour own list: %s (%s entries)\n' "$deny" \
    "$(grep -Evc '^[[:space:]]*(#|$)' "$deny" || true)"
}

cmd_add() { # name url
  local name="$1" url="$2"
  valid_name "$name" || die "list names are letters, digits, '.', '_' and '-'"
  [[ "$url" =~ ^https:// ]] || die "use an https:// URL"
  [ -z "$(url_for "$name")" ] || die "$name is already subscribed (remove it first)"
  [ "$(subscriptions | wc -l)" -lt "$MAX_LISTS" ] || die "at most $MAX_LISTS lists"
  fetch "$name" "$url" || die "not subscribed"
  printf '%s %s\n' "$name" "$url" >> "$CONF"
}

cmd_remove() { # name
  local name="$1"
  [ -n "$(url_for "$name")" ] || die "no list called $name"
  awk -v n="$1" '$1 != n' "$CONF" > "$CONF.new" && mv -f "$CONF.new" "$CONF"
  rm -f "$DIR/$name.txt"
  say "removed $name"
}

cmd_update() { # [--if-older HOURS]
  local older="" name url f failed=0 changed=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --if-older) older="$2"; shift 2 ;;
      --quiet) QUIET=1; shift ;;
      *) die "usage: update [--if-older HOURS] [--quiet]" ;;
    esac
  done
  while read -r name url; do
    f="$DIR/$name.txt"
    if [ -n "$older" ] && [ -f "$f" ] && [ "$(age_hours "$f")" -lt "$older" ]; then continue; fi
    if fetch "$name" "$url"; then changed=1; else failed=1; fi
  done < <(subscriptions)
  [ "$changed" = 1 ] && reload hup
  return "$failed"
}

# Every rule that matches DOMAIN or a domain above it, from each list and the user's own.
cmd_check() { # domain
  local host="${1,,}" d files=() found=0 f hits
  host="${host%.}"
  for f in "$CONF_DIR/deny" "$DIR"/*.txt; do [ -f "$f" ] && files+=("$f"); done
  d="$host"
  while :; do
    local re="${d//./\\.}"
    for f in "${files[@]}"; do
      # As the proxy reads them: a bare domain, "*.", a hosts entry, or ||domain^.
      hits="$(grep -EinH "^[[:space:]]*(@@)?(\|\||\*\.|\.|([0-9a-f.:]+[[:space:]]+([^#]*[[:space:]])?))?$re\.?(\^)?([[:space:]]|#|$)" "$f" 2>/dev/null | head -3 || true)"
      [ -n "$hits" ] && { found=1; printf '%s\n' "$hits"; }
    done
    [[ "$d" == *.* ]] || break
    d="${d#*.}"
  done
  [ "$found" = 1 ] || echo "$host: not on any list"
}

case "${1:-list}" in
  list) cmd_list ;;
  defaults)
    added=0
    while read -r name url; do
      if [ -z "$(url_for "$name")" ]; then cmd_add "$name" "$url" && added=1; fi
    done <<< "$DEFAULTS"
    [ "$added" = 1 ] && reload restart
    cmd_list ;;
  add) [ $# -eq 3 ] || die "usage: add NAME URL"; cmd_add "$2" "$3"; reload restart ;;
  remove) [ $# -eq 2 ] || die "usage: remove NAME"; cmd_remove "$2"; reload restart ;;
  update) shift; cmd_update "$@" ;;
  check) [ $# -eq 2 ] || die "usage: check DOMAIN"; cmd_check "$2" ;;
  -h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "usage: termux-http-proxy-blocklists [list|defaults|add|remove|update|check] (--help)" ;;
esac
